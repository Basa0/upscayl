{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capabilities for the main Upscayl window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:1420", "http://localhost:1420/"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-progress-bar",
    "dialog:default",
    "opener:default",
    "notification:default",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-spawn",
    "clipboard-manager:default",
    "log:default"
  ]
}
