{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upscayl",
  "version": "26.0.1",
  "identifier": "org.upscayl.Upscayl",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist/upscayl/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Upscayl",
        "width": 1300,
        "height": 940,
        "minWidth": 600,
        "minHeight": 500,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/upscayl-bin"],
    "resources": {
      "../resources/models": "models"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
